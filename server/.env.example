# Copy to .env and fill in. Never commit the real .env file.

PORT=3000

# How often the backend polls Google/Microsoft for changes (ms).
# Polls use delta/sync tokens, so most polls cost one cheap "anything new?"
# request rather than re-fetching everything.
POLL_INTERVAL_MS=60000

# GOOGLE_CLIENT_ID/SECRET and MS_CLIENT_ID/SECRET are no longer entered
# here -- the companion app has its own form for both (Google Calendar and
# Microsoft To Do Reminders sections each have a "Where do I get this?"
# walkthrough plus the fields themselves), and whatever's saved there
# takes priority over these. Left here only as an optional fallback for
# anyone who prefers a file over a web form.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
# Which To Do list(s) sync is chosen in the companion app after connecting,
# not here — every list on the account (including ones shared with you) is
# discovered automatically and can be toggled on/off individually.
