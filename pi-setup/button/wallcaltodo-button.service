[Unit]
Description=WallCalToDo physical view-switch button
After=network.target wallcaltodo.service
Wants=wallcaltodo.service

[Service]
ExecStart=/usr/bin/python3 /home/pi/WallCalToDo/pi-setup/button/button.py
Restart=on-failure
RestartSec=5
User=pi
Environment=WALLCALTODO_SERVER_URL=http://localhost:3000
Environment=WALLCALTODO_BUTTON_PIN=17

[Install]
WantedBy=multi-user.target
